# OCR Worker Configuration

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis Stream Configuration
OCR_STREAM_KEY=ocr:tasks
OCR_RESULT_KEY=ocr:results
OCR_DLQ_KEY=ocr:tasks:dlq
OCR_CONSUMER_GROUP=ocr-workers
OCR_MAX_RETRY=3
OCR_PENDING_TIMEOUT_MS=60000

# JeecgBoot Callback Configuration (DEPRECATED - now using Redis Stream)
# Callbacks are now sent via Redis Stream (ocr:results) instead of HTTP
# This avoids HTTPS/SSL compatibility issues between Python and Undertow
JEECG_BASE_URL=http://localhost:8080/jeecg-boot
JEECG_CALLBACK_PATH=/ocr/api/callback
JEECG_API_TOKEN=

# OCR Configuration
OCR_USE_GPU=false
OCR_MODEL_DIR=./models
OCR_DEFAULT_LANG=ch
OCR_CONFIDENCE_THRESHOLD=0.8

# Layout Analysis Configuration
# 方案 A: PPStructure 表格识别 (目前禁用，bbox 偏移问题)
OCR_USE_PPSTRUCTURE_TABLE=false

# 方案 B: DocLayout-YOLO (MinerU 级别版式分析)
# 需要安装: pip install doclayout-yolo huggingface_hub ultralytics
OCR_USE_DOCLAYOUT_YOLO=false
OCR_DOCLAYOUT_MODEL_PATH=
OCR_DOCLAYOUT_CONF_THRESHOLD=0.25

# API Configuration
API_HOST=0.0.0.0
API_PORT=8100
API_WORKERS=1

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs

